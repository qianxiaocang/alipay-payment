# ==============================================================================
# AI 收（A2M 智能收）配置模板 —— Node.js
# ==============================================================================
# 使用方式：
#   cp .env.example .env
#   编辑 .env 填入真实配置
#   验证：npm run check-config
#
# ⛔ 本文件为空白模板。禁止用示例值、占位符冒充真实配置。
# ⛔ .env 已被 .gitignore 忽略，切勿提交到任何仓库。
# ⛔ 本文件用于【生产配置】。启动后每一笔请求都是真实交易。
#    如需沙箱联调，请改用 alipay-aipay 技能的沙箱流程（serviceId=api_mock_service_id
#    + 沙箱网关），本实现按生产语义严格实现，不含沙箱分支。
# ==============================================================================


# ------------------------------ 入驻后取得（必填） ------------------------------

# 应用ID
ALIPAY_APP_ID=

# 商户ID（2088 开头的纯数字）
ALIPAY_SELLER_ID=

# 商户服务ID（与入驻时上架的服务对应）
ALIPAY_SERVICE_ID=

# 商户名称
ALIPAY_SELLER_NAME=


# --------------------------------- 密钥（必填） ---------------------------------

# 应用私钥。Node.js 属非 JAVA 语言，必须使用 PKCS#1 格式。
# 从开放平台取【PKCS#1】格式，或非 JAVA 语言的 appPrivatePkcsKey 字段。
# ⛔ 禁止用 openssl 转换格式，禁止手工拼接 PEM 头尾。
#
# 两种填法二选一（推荐 _FILE，可避免多行 PEM 在 .env 中的换行问题）：
#   填法 A：ALIPAY_APP_PRIVATE_KEY_FILE=/绝对路径/app_private_key.pem
#   填法 B：ALIPAY_APP_PRIVATE_KEY=<单行裸 base64> 或 "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_FILE=

# 支付宝公钥（用于响应验签；注意不要填成「应用公钥」）
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_FILE=


# -------------------------------- 业务参数（必填） --------------------------------

# 收费金额（单位：元，字符串形式，如 0.01）
# 必须与入驻时该 service-id 对应的价格一致
ALIPAY_AMOUNT=

# 支付截止时间（分钟，正整数）。留空则默认 30
ALIPAY_PAY_BEFORE_MINUTES=30


# ------------------------------- 业务资源（你卖什么） -------------------------------
# provider：static（占位内容，仅跑通链路）| api（把买家请求转发给你的业务 API）
# 「API 按次付费」场景使用 api。
# 本地联调：先 `npm run business-api` 起示例桩，再按下面注释配置。
RESOURCE_PROVIDER=static

# 买家付费后被调用一次的业务 API 地址
# 两种联调方式二选一：
#   A) 指向本服务挂载的占位接口：https://你的域名/action
#   B) 另起独立桩：http://127.0.0.1:4000/paid-api（由 `npm run business-api` 提供）
BUSINESS_API_URL=
BUSINESS_API_METHOD=POST
BUSINESS_API_TIMEOUT_MS=15000

# 是否在本服务内挂载示例业务接口（占位）
# 打开后 BUSINESS_API_URL 可以直接指向本服务的 /action，无需另起业务服务。
# ⚠️ 这是占位实现（返回固定 ok + 幂等 pick_token），上线前必须替换为真实业务接口
#    或设为 false 关闭本路由。
MOUNT_DEMO_BUSINESS=true
BUSINESS_API_LOCAL_PATH=/action

# 调用业务 API 的鉴权头（留空则不带）
BUSINESS_API_AUTH_HEADER=
BUSINESS_API_AUTH_VALUE=

# 幂等键头名，值固定为订单号 out_trade_no，防止上游被重复调用
BUSINESS_API_IDEMPOTENCY_HEADER=Idempotency-Key

# 是否把买家的 query 透传给业务 API
BUSINESS_API_PASS_QUERY=true

# 是否把上游响应包一层可归属元数据（status/resource_id/out_trade_no/trade_no/data）
# 默认 false：content 直接就是业务 API 原文，消费方读 JSON.parse(body.content).<字段>
# 置 true 则字段会多套一层：JSON.parse(body.content).data.<字段>
RESOURCE_WRAP_RESPONSE=false

# 包裹时的 service_type 标识
RESOURCE_SERVICE_TYPE=API_CALL

# 载荷绑定：把「被收费的那次请求」与「实际执行的请求」绑定。
# 防止「用便宜请求付款 → 重放昂贵请求」的低价套利，强烈建议保持 true。
RESOURCE_BIND_PAYLOAD=true

# 请求体大小上限（字节）。这也是单次调用的成本上界，按你的业务设定。
MAX_BODY_BYTES=1048576

# 资源生成租约（毫秒）。持有者崩溃后超时可由其它实例接管生成。
GENERATE_LEASE_MS=60000


# ------------------------------ 固定默认（不可修改） ------------------------------
# 以下四项由协议规定，代码中已强制固定。填了别的值会导致启动失败。
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=UTF-8
ALIPAY_FORMAT=json
ALIPAY_CURRENCY=CNY


# --------------------------------- 运行时配置 ---------------------------------

# 生产网关（本实现仅支持生产网关，不可改为沙箱地址）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 付费资源接口路径
RESOURCE_PATH=/demo/a2m/resource

# 商品名称（会出现在 402 响应与支付请求中）
GOODS_NAME=AI 生成内容服务

# 监听端口
PORT=3000

# ----------------------------- 订单存储（必填） -----------------------------
# 驱动：json（单实例）| mysql | postgres（多实例）
# ⚠️ json 使用进程内互斥，**只能单实例部署**；多实例必须用数据库。
ORDER_STORE_DRIVER=json

# json 驱动的存储文件路径（生产必须有持久化；禁止 :memory:）
ORDER_STORE_PATH=./data/orders.json

# 数据库连接（ORDER_STORE_DRIVER=mysql|postgres 时必填）
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_TABLE=aipay_orders
# 云数据库通常要求 TLS
DB_SSL=false

# 回执认领租约（毫秒）。持有者崩溃后，超过此时长其它实例可接管上报。
CONFIRM_LEASE_MS=30000

# 回执正被其它执行者认领时，本请求最多等待多久再决定返回成功或可重试失败
CONFIRM_WAIT_MS=2000

# 网关响应验签：恒定开启，不提供关闭开关。
# 官方《代码开发校验清单》要求生产源码中不存在可触达的跳过验签旁路，
# 因此这里没有对应环境变量；如需排查验签问题请用独立诊断而非关闭校验。

# 网关请求超时（毫秒）
ALIPAY_TIMEOUT_MS=10000
